# Postgres connection string (e.g. a free Neon database)
DATABASE_URL=postgres://user:password@localhost:5432/release_brief
PORT=3001

# Which model writes the analysis and summaries: mock | gemini | anthropic
# "mock" needs no key and is deterministic (tests, keyless demos). Use a real provider for real output.
LLM_PROVIDER=mock

# Google AI Studio key (free tier available): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic API key (needs billing set up)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional tuning
# LLM_TIMEOUT_MS=60000
# LLM_RETRIES=1
# LLM_RETRY_DELAY_MS=2000
